# Секреты стенда. Скопируйте в .env — Compose подхватит его сам:
#   cp .env.example .env
# Сам .env под gitignore. Без него `docker compose` падает с явной ошибкой:
# тихого запуска на пароле по умолчанию быть не должно.
#
# Значения ниже — заведомые заглушки для локального стенда. Для любого общего
# окружения задайте свои и помните, что .env хранилищем секретов не является:
# значения видны в `docker compose config` и `docker inspect`.

# --- PostgreSQL ---
# Суперпользователь кластера. Роли сервисов создаёт init-скрипт и суперпользо-
# вателями они не являются.
POSTGRES_SUPERUSER=postgres
POSTGRES_PASSWORD=change-me-postgres
CATALOG_DB_PASSWORD=change-me-catalog
INDEXING_DB_PASSWORD=change-me-indexing
RESEARCH_AGENT_DB_PASSWORD=change-me-research-agent

# --- RabbitMQ ---
RABBITMQ_USER=platform
RABBITMQ_PASSWORD=change-me-rabbitmq

# --- LLM ---
# По умолчанию стенд ходит в контейнер test-doubles: он детерминирован,
# бесплатен и не требует настоящего ключа — на нём держатся сквозные тесты.
LLM_BASE_URL=http://test-doubles:8000/v1
LLM_MODEL=deterministic-test-llm
LLM_API_KEY=stand-llm-key

# Боевой провайдер — DeepInfra. Чтобы переключить стенд, замените три строки
# выше на эти и подставьте свой токен. Учтите: сквозные сценарии рассчитаны на
# детерминированный дубль и на живой модели воспроизводимыми не будут.
#   LLM_BASE_URL=https://api.deepinfra.com/v1/openai
#   LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
#   LLM_API_KEY=<токен DeepInfra>

# --- Web-поиск ---
# Тоже заменён дублем формата Tavily; значение любое непустое.
WEB_SEARCH_API_KEY=stand-web-search-key
