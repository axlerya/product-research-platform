# Все переменные — с префиксом RESEARCH_AGENT_ (pydantic-settings).

# --- Идентификация сервиса ---
RESEARCH_AGENT_SERVICE_NAME=research-agent-service
RESEARCH_AGENT_LOG_LEVEL=INFO

# --- PostgreSQL (история диалогов, agent_runs, tool_calls, feedback, outbox) ---
RESEARCH_AGENT_DATABASE_URL=postgresql+asyncpg://research_agent:research_agent@localhost:5432/research_agent

# --- Redis (кеш, rate limiting, идемпотентность) ---
RESEARCH_AGENT_REDIS_URL=redis://localhost:6379/0

# --- RabbitMQ (публикация событий через outbox-relay) ---
RESEARCH_AGENT_RABBITMQ_DSN=amqp://guest:guest@localhost:5672/

# --- embedding-service (gRPC) ---
# Эмбеддинг запроса и переранжирование — разные сервисы одного контракта,
# адреса задаются раздельно: reranker может жить и масштабироваться отдельно.
RESEARCH_AGENT_EMBEDDING_GRPC_TARGET=localhost:50051
RESEARCH_AGENT_RERANKER_GRPC_TARGET=localhost:50051
# Дедлайны рассчитаны на GPU. На CPU те же модели отвечают в разы медленнее —
# поднимите, иначе каждый запрос уходит в деградацию по DEADLINE_EXCEEDED.
RESEARCH_AGENT_EMBEDDING_DEADLINE_S=1.5
RESEARCH_AGENT_RERANKER_DEADLINE_S=5.0

# --- Qdrant (read-only гибридный поиск через алиас коллекции) ---
RESEARCH_AGENT_QDRANT_URL=http://localhost:6333
RESEARCH_AGENT_QDRANT_COLLECTION=products

# --- catalog-service (авторитетные данные и ценовой анализ по REST) ---
RESEARCH_AGENT_CATALOG_BASE_URL=http://localhost:8000

# --- Web-поиск: "tavily" | "serper" ---
RESEARCH_AGENT_WEB_SEARCH_PROVIDER=tavily
RESEARCH_AGENT_WEB_SEARCH_API_KEY=
# Пусто = публичный эндпоинт провайдера. Задайте свой адрес того же API,
# чтобы увести web-поиск в изолированный контур.
RESEARCH_AGENT_WEB_SEARCH_BASE_URL=

# --- Outbox-relay: период дренажа и размер партии ---
RESEARCH_AGENT_RELAY_INTERVAL_S=1.0
RESEARCH_AGENT_RELAY_BATCH_SIZE=100

# --- LLM: DeepInfra (OpenAI-совместимый эндпоинт) ---
# Токен берётся в консоли DeepInfra; без него провайдер ответит 401.
RESEARCH_AGENT_LLM__BASE_URL=https://api.deepinfra.com/v1/openai
RESEARCH_AGENT_LLM__MODEL=deepseek-ai/DeepSeek-V4-Flash
RESEARCH_AGENT_LLM__API_KEY=
RESEARCH_AGENT_LLM__TEMPERATURE=0.0
RESEARCH_AGENT_LLM__MAX_TOKENS=4096
# Сетевой провайдер отвечает дольше локального — запас по таймауту нужен.
RESEARCH_AGENT_LLM__TIMEOUT=120.0
RESEARCH_AGENT_LLM__MAX_RETRIES=3
# Оба поля нестандартные и по умолчанию НЕ отправляются: service_tier —
# расширение OpenAI, ENABLE_THINKING — vLLM-совместимых. Задавайте только
# если провайдер их понимает, иначе рискуете получить отказ на каждый вызов.
# RESEARCH_AGENT_LLM__SERVICE_TIER=auto
# RESEARCH_AGENT_LLM__ENABLE_THINKING=false

# --- Наблюдаемость: distributed tracing (опционально) ---
# Пусто = трейсинг выключен. Задайте OTLP/HTTP endpoint, чтобы включить.
# RESEARCH_AGENT_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
