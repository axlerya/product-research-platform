{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POST /api/v1/analytics/prices — кросс-сервисный контракт",
  "description": "Что research-agent-service реально читает из ответа каталога (HttpCatalogClient._analysis). Числа приходят строками: Decimal собирается из них напрямую, float потерял бы точность.",
  "type": "object",
  "additionalProperties": true,
  "required": ["count", "currency", "price", "margin", "analysis_ref"],
  "properties": {
    "count": { "type": "integer", "minimum": 0 },
    "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
    "analysis_ref": { "type": "string", "pattern": "^pa-[0-9a-f]{16}$" },
    "price": {
      "type": "object",
      "additionalProperties": true,
      "required": ["min", "max", "avg", "median", "stddev"],
      "properties": {
        "min": { "$ref": "#/$defs/decimalString" },
        "max": { "$ref": "#/$defs/decimalString" },
        "avg": { "$ref": "#/$defs/decimalString" },
        "median": { "$ref": "#/$defs/decimalString" },
        "stddev": { "$ref": "#/$defs/decimalString" }
      }
    },
    "margin": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "min_percent",
        "max_percent",
        "avg_percent",
        "median_percent",
        "undefined_count",
        "negative_count"
      ],
      "properties": {
        "min_percent": { "$ref": "#/$defs/decimalString" },
        "max_percent": { "$ref": "#/$defs/decimalString" },
        "avg_percent": { "$ref": "#/$defs/decimalString" },
        "median_percent": { "$ref": "#/$defs/decimalString" },
        "undefined_count": { "type": "integer", "minimum": 0 },
        "negative_count": { "type": "integer", "minimum": 0 }
      }
    },
    "bands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["label", "count"],
        "properties": {
          "label": { "type": "string" },
          "count": { "type": "integer", "minimum": 0 },
          "lower_percent": { "$ref": "#/$defs/optionalDecimalString" },
          "upper_percent": { "$ref": "#/$defs/optionalDecimalString" }
        }
      }
    },
    "outliers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["sku", "price", "reason", "score"],
        "properties": {
          "sku": { "type": "string", "minLength": 1 },
          "reason": { "type": "string" },
          "score": { "$ref": "#/$defs/decimalString" },
          "price": {
            "type": "object",
            "additionalProperties": true,
            "required": ["amount", "currency"],
            "properties": {
              "amount": { "$ref": "#/$defs/decimalString" },
              "currency": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "decimalString": { "type": "string", "pattern": "^-?[0-9]+\\.[0-9]{2}$" },
    "optionalDecimalString": {
      "oneOf": [
        { "type": "string", "pattern": "^-?[0-9]+\\.[0-9]{2}$" },
        { "type": "null" }
      ]
    }
  }
}
